{
  "$schema": "https://t3.codes/schema/t3.json",
  "iconPath": "assets/dev/blueprint-web-apple-touch-180.png",
  "scripts": [
    {
      "name": "Setup Worktree",
      "command": "node scripts/setup-worktree.ts",
      "icon": "configure",
      "runOnWorktreeCreate": true
    },
    {
      "name": "Plans (this project)",
      "command": "agent-workbench ~/knowledge-hub/plans",
      "icon": "play",
      "previewUrl": "http://localhost:4317/@t3code",
      "autoOpenPreview": true
    },
    {
      "name": "Plans (all projects)",
      "command": "agent-workbench ~/knowledge-hub/plans",
      "icon": "play",
      "previewUrl": "http://localhost:4317",
      "autoOpenPreview": true
    },
    {
      "name": "Session vitals",
      "command": "agent-workbench ~/knowledge-hub/plans",
      "icon": "play",
      "previewUrl": "http://localhost:4317/vitals",
      "autoOpenPreview": true
    }
  ]
}
